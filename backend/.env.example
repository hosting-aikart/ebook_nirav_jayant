# Copy to backend/.env (it is git-ignored; never commit it).

# Port of the API server. The website's dev server (port 5173) forwards /api here.
PORT=5000

# Neon → your project → Connect → connection string (the "Pooled connection" one is fine).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Razorpay → Account & Settings → API Keys. Test keys (rzp_test_...) charge nothing;
# live keys (rzp_live_...) take real payments.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Optional: the secret you type when creating the Razorpay webhook (see backend/README.md).
# Checkout works without it; the webhook is the backup if a customer closes the tab.
RAZORPAY_WEBHOOK_SECRET=

# Sign-in for the admin panel at /admin. Use a long password you don't use anywhere else.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
